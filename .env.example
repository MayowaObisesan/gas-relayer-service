# Relayer Wallet (the "God Key"). NEVER commit a real key.
PRIVATE_KEY=

# --- optional overrides ----------------------------------------------------
# Public node. Used for `eth_call` (the dry run), the chain id, and receipts.
#RPC_URL=http://127.0.0.1:8545

# Private orderflow endpoint (Flashbots relay, a builder, a second node...).
# When set, the relayer STILL simulates against RPC_URL, but broadcasts only
# here, so the signed transaction never enters the public mempool.
#PRIVATE_RPC_URL=https://relay.flashbots.net
#FLASHBOTS_RPC_URL=https://relay.flashbots.net

# Trusted forwarder every intent is relayed to. Bound into the EIP-712 domain,
# so changing it invalidates every client signature.
#FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000

# API bind address. Use 127.0.0.1, never `localhost`: on macOS `localhost`
# resolves to ::1 first and the IPv4-only listener looks silently broken.
#BIND_ADDR=127.0.0.1:3000

# EIP-712 domain. Both values are part of the domain separator.
#EIP712_NAME=HardenedRelayer
#EIP712_VERSION=1

# Defensive limits.
#MAX_SEEN_ENTRIES=100000   # bound on the used-signature registry (memory)
#QUEUE_CAPACITY=100        # intents in flight before 503 back-pressure
#AWAIT_RECEIPTS=1          # 0 = fire and forget, 1 = measure gas burned on reverts

# --- lab switches (Part 1: show the loss, then show it stopped) ------------
#DRY_RUN=1                 # 0 = skip eth_call and buy failing transactions like Day 3
#GAS_LIMIT=100000          # explicit gas limit; this also skips eth_estimateGas, whose
                           # failure would otherwise hide the loss from you

# Simulator target only (src/bin/simulator.rs).
#RELAYER_URL=http://127.0.0.1:3000

# --- Week 5: the keeper (src/bin/keeper.rs) --------------------------------
# Same RPC_URL and PRIVATE_KEY as the relayer above; the keeper adds these.

# The lending pool to watch. It MUST have code: the keeper refuses to start against the zero
# address, because an empty account answers checkUpkeep() with nothing and the keeper would
# report perfect health forever. Deploy one with:
#     cargo run --bin keeper -- deploy-pool        (embedded bytecode, no toolchain needed)
#     ./scripts/deploy_pool.sh                    (compile contracts/LendingPoolMock.sol)
#POOL_ADDRESS=0x0000000000000000000000000000000000000000

# WebSocket endpoint for the log subscription. Derived from RPC_URL by rewriting the scheme
# (http -> ws, https -> wss); the PORT is deliberately not guessed, because anvil and geth both
# serve 8545 for HTTP and 8546 for WS. Set this explicitly if the keeper logs
# "cannot connect to ws://...".
#WS_RPC_URL=ws://127.0.0.1:8546

# How often to ask checkUpkeep() even when no event arrived. THIS IS THE KEEPER'S REAL REACTION
# TIME: if the socket dies, this interval is how long the pool is unguarded. Default 30.
#KEEPER_POLL_SECS=30

# Hard cap on broadcasts per hour. A keeper with a bug in its trigger filter is a loop that
# spends money; this bounds the damage. 0 disables the cap and the banner says so in red.
#KEEPER_MAX_TX_PER_HOUR=12

# EIP-1559 priority fee in gwei. A liquidation is a race, so this sits above the node's
# suggestion. The fee cap is derived as 2x this, and must stay above it.
#KEEPER_PRIORITY_FEE_GWEI=2

# Depth of the in-process trigger queue. A full queue drops a *nudge*, which the poll timer
# recovers from, so this is a courtesy to the watcher rather than a correctness mechanism.
#KEEPER_QUEUE_CAPACITY=100

# Explicit gas limit for performUpkeep. Unset means "let the node estimate", which is the honest
# choice because performUpkeep touches storage.
#KEEPER_GAS_LIMIT=500000

#KEEPER_AWAIT_RECEIPTS=1     # 0 = fire and forget, and then the gas metrics mean nothing
#KEEPER_DRY_RUN=1            # LAB SWITCH. 0 = skip the eth_call and buy reverting liquidations
#KEEPER_BIND_ADDR=127.0.0.1:3001   # /metrics, /health, POST /upkeep (one above the relayer)
